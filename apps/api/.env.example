# API Configuration
API_BASE=https://your-api.com/api/v1
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="your_db_url"

# Redis (BullMQ - Local Only)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Redis (Serverless Rate Limiting - HTTP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash (Serverless Jobs)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=https://qstash.upstash.io/v2

# Paystack (NGN domestic bank transfer — DVA settlement)
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# ChainRails (connected-wallet flow — not fully wired yet)
CHAINRAILS_API_URL=https://api.chainrails.io/api/v1
CHAINRAILS_API_KEY=
CHAINRAILS_WEBHOOK_SECRET=

# NEAR Intents 1Click (send-from-another-wallet flow — primary provider today)
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com/v0
NEAR_INTENTS_JWT=your_jwt_here

# Poll interval in ms for the NEAR Intents status worker (default 15000)
NEAR_POLL_INTERVAL_MS=15000

# Paycrest Sender API
PAYCREST_API_URL=https://api.paycrest.io/v2
PAYCREST_API_KEY=
PAYCREST_WEBHOOK_SECRET=

# System-owned EVM address used as Paycrest's refundAddress. Paycrest validates
# refund addresses against its refund leg (Base USDC), so when the user pays
# from a non-EVM chain (Solana, TRON, etc.) we can't forward their origin-chain
# refund address to Paycrest. Must be a valid 0x… address.
WEAVE_EVM_REFUND_ADDRESS=

# Merchant payout config (demo-only — moves to dashboard later)
MERCHANT_PAYOUT_INSTITUTION=GTBINGLA
MERCHANT_PAYOUT_ACCOUNT_IDENTIFIER=1234567890
MERCHANT_PAYOUT_ACCOUNT_NAME=Your Merchant Name
MERCHANT_PAYOUT_WALLET_ADDRESS=0xYourMerchantWalletAddress
MERCHANT_PAYOUT_WALLET_CHAIN=base

# Fee config (can be overridden per client in future)
SENDER_FEE_BPS=75     # 0.75%
APP_FEE_BPS=10        # 0.10%

# Swap-slippage buffer. Applied to dest-anchored quotes so the merchant always
# receives at least the requested fiat amount even after NEAR Intents eats its
# cross-chain spread. Also doubles as the slippageTolerance we pass to NEAR
# Intents so the swap doesn't abort mid-flight. 200 = 2%.
SLIPPAGE_BUFFER_BPS=200

NODE_ENV=development
PORT=4000

# Dashboard auth session + password reset
AUTH_SESSION_TTL_HOURS=24
AUTH_RESET_TTL_MINUTES=15

# Email service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@weave.dev
ADMIN_EMAIL=
DASHBOARD_URL=http://localhost:3001

# Dev-only: set to "true" to skip QStash signature verification locally.
# Never set this in production.
SKIP_QSTASH_VERIFICATION=false

