generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Merchants ────────────────────────────────────────────────────────────────
// A Merchant is the entity that integrates Weave into their product. They are
// simultaneously:
//   • a credentialled user (email + password, dashboard login)
//   • an API client (publishableKey for browser widget, KeyPairs for server SDK)
//   • a business account (payout instruments, transaction owner)

model Merchant {
  id                        String       @id @default(uuid())
  email                     String       @unique
  passwordHash              String?
  name                      String
  kycLevel                  String       @default("none") // "none" | "basic" | "verified"
  // Publishable key (pk_live_...) — safe to ship in browser JS.
  // Secret keys are stored hashed in the KeyPair table and never kept plaintext.
  publishableKey            String       @unique
  sandboxPublishableKey     String?      @unique
  defaultPayoutInstrumentId String?      // FK-ish (not enforced to avoid cycle with Instrument)
  
  // Outgoing Notifications
  webhookUrl                String?
  webhookSecret             String?      @default(dbgenerated("gen_random_uuid()")) // default for convenience
  
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  emailVerifiedAt            DateTime?
  paystackSubaccountCode     String?
  paystackSubaccountStatus   SubaccountSyncStatus @default(PENDING)
  paystackSubaccountSyncedAt DateTime?
  // Bachs Connect: the merchant's connected account ("org_…"). Naira collection
  // splits each order's share to this account. Capability statuses are cached so
  // the dashboard can gate order creation on `transfers` being active without an
  // API round-trip. `bachsPayoutDestinationId` ("pd_…") is the merchant's bank
  // destination for withdrawals; resolved during onboarding.
  bachsConnectedAccountId    String?  @unique
  bachsTransfersStatus       String?  // "restricted" | "pending" | "active"
  bachsPayoutsStatus         String?  // "restricted" | "pending" | "active"
  bachsPayoutDestinationId   String?
  bachsOnboardedAt           DateTime?
  sessions           Session[]
  instruments        Instrument[]
  orders             Order[]
  keyPairs           KeyPair[]
  // Merchant brand profile — themes the hosted cash-out page so it reads as the
  // merchant's own offramp product. Shape: { logoUrl?, accentColor?, displayName?,
  // headline?, subheadline?, bgColor?, bgImageUrl?, font? }. Display-only, so JSON
  // is fine and future-proof; validated/whitelisted in the route.
  brand              Json?
  paymentLinks       PaymentLink[]
  payoutLinks        PayoutLink[]
  checkoutSessions   CheckoutSession[]
  verification       BusinessVerification?
  deliveries         WebhookDelivery[]
}

model BusinessVerification {
  id                  String   @id @default(uuid())
  merchantId          String   @unique
  merchant            Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  // Step 1: Identity
  firstName           String?
  lastName            String?
  dob                 String?  // ISO date string
  personalAddress     String?
  
  // Step 2: Business Details
  legalName           String?
  dba                 String?
  entityType          String?  // "LLC" | "Sole Proprietorship" | "Cooperative" | etc
  regNumber           String?
  businessAddress     String?
  city                String?
  state               String?
  postalCode          String?

  // Business profile — also maps to Bachs `business_profile.*` when a connected
  // account requests collection capabilities.
  websiteUrl          String?
  productDescription  String?
  supportEmail        String?
  productCategory     String?
  socialMedia         String?

  // Step 3: Documents
  documentUrls        Json?    // Array of { type: string, url: string }
  
  status              String   @default("none") // "none" | "pending" | "verified" | "rejected"
  rejectionReason     String?
  
  submittedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Session {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([merchantId])
}

model OtpChallenge {
  id         String    @id @default(uuid())
  channel    String    // "email" | "sms"
  target     String    // email address or phoneE164
  codeHash   String    // SHA-256 of the 6-digit code
  purpose    String    // "login" | "verify_instrument" | "password_reset"
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, purpose])
}

// ── KeyPairs ─────────────────────────────────────────────────────────────────
// Secret-key credentials for server-to-server integrations.
// The raw secretKey is shown to the merchant exactly once and then discarded;
// only hashedSecretKey is persisted here.

model KeyPair {
  id              String   @id @default(cuid())
  publicKey       String   @unique  // pk_live_... (live) or pk_test_... (sandbox); matches the Merchant's live/sandbox publishable key
  hashedSecretKey String
  merchantId      String
  merchant        Merchant @relation(fields: [merchantId], references: [id])
  isActive        Boolean  @default(true)
  isSandbox       Boolean  @default(false) // true → server-to-server auth with this pair runs in sandbox mode
  createdAt        DateTime  @default(now())
  updatedAt       DateTime @updatedAt

  @@index([merchantId])
  // Secret key auth resolves the pair by hashed secret (see requireKeyPair).
  @@index([hashedSecretKey])
}

// ── Instruments ─────────────────────────────────────────────────────────────
// Unified model for "a thing money moves into/out of":
//   • Merchant payout destinations (merchant bank or wallet)
//   • Inline instruments created at order time (anonymous payer bank/wallet)
//
// assetKey encodes the rail + asset:
//   "fiat:NGN" · "fiat:USD" · "crypto:BASE:USDC" · "crypto:STELLAR:USDC"

model Instrument {
  id                    String   @id @default(uuid())
  merchantId            String?
  merchant              Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  kind                  String   // "bank_account" | "crypto_wallet"
  assetKey              String
  label                 String?

  // Bank fields (null when kind = crypto_wallet)
  bankInstitution       String?
  bankAccountIdentifier String?
  bankAccountName       String?

  // Crypto fields (null when kind = bank_account)
  walletAddress         String?

  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sourceOrders          Order[]   @relation("OrderSource")
  destOrders            Order[]   @relation("OrderDest")

  @@index([merchantId])
  @@index([assetKey])
}

// ── Orders + Route steps ────────────────────────────────────────────────────

model Order {
  id                 String       @id @default(uuid())
  merchantId         String
  merchant           Merchant     @relation(fields: [merchantId], references: [id])

  sourceInstrumentId String
  sourceInstrument   Instrument   @relation("OrderSource", fields: [sourceInstrumentId], references: [id])
  destInstrumentId   String
  destInstrument     Instrument   @relation("OrderDest",   fields: [destInstrumentId],   references: [id])

  sourceAssetKey     String       // denormalized for quick filtering
  destAssetKey       String
  sourceAmount       Decimal      @db.Decimal(36, 18)
  destAmount         Decimal?     @db.Decimal(36, 18)  // confirmed settled amount, updated on completion
  quoteRate          Decimal?     @db.Decimal(36, 18)  // source→dest rate snapshot at creation

  sandboxMode        Boolean      @default(false)
  status             String       // "awaiting_deposit" | "processing" | "completed" | "failed" | "refunded"
  routePlan          Json?        // RoutePlan snapshot from the router
  reference          String?      // merchant-supplied reference
  // Merchant-supplied payer identity, pure passthrough. Weave does not verify
  // any of these fields — they're echoed in webhooks and shown on receipts so
  // merchants can attach their own customer record to the order. Shape:
  //   { email?: string, name?: string, externalId?: string }
  customer           Json?
  senderFeeUsd       Decimal?     @db.Decimal(18, 8)
  appFeeUsd          Decimal?     @db.Decimal(18, 8)
  bridgeFeeUsd       Decimal?     @db.Decimal(18, 8)

  // Bachs split settlement — decoupled from `status`. The order is 'completed'
  // when the customer pays (collection); the vendor's share then transfers to
  // their connected account as a post-completion settlement tracked here.
  bachsSplitStatus     String?    // "pending" | "settled" | "failed"
  bachsSplitTransferId String?    // Bachs transfer id ("tr_…") once the split posts
  bachsSplitAt         DateTime?

  // Bachs payout (withdrawal) — the final leg: connected-account balance → vendor's
  // own bank. Deferred behind the split and behind an optional hold window
  // (BACHS_PAYOUT_HOLD_S), so payout timing is a lever independent of collection.
  bachsPayoutStatus    String?    // "pending" | "processing" | "paid" | "failed" | "blocked"
  bachsWithdrawalId    String?    // Bachs withdrawal_id once the withdrawal posts
  bachsPayoutAt        DateTime?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  steps              RouteStep[]
  webhookLogs        WebhookLog[]
  events             OrderEvent[]
  stellarAnchorTx    StellarAnchorTransaction?

  @@index([merchantId])
  @@index([status])
  // Covers GET /orders (merchantId + sandboxMode equality, createdAt sort + limit)
  // and the basic-tier monthly limit count (merchantId + createdAt range) without
  // falling back to an unordered scan over every one of the merchant's orders.
  @@index([merchantId, sandboxMode, createdAt])
  // Prevents duplicate orders for the same merchant+reference under concurrent requests.
  // NULL reference values are exempt (PostgreSQL treats NULL != NULL for unique constraints).
  @@unique([merchantId, reference])
}

model RouteStep {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence       Int
  provider       String    // "paycrest" | "chainrails" | "nearintents" | "direct"
  fromAsset      String
  toAsset        String
  amountIn       Decimal?     @db.Decimal(36, 18)
  amountOut      Decimal?     @db.Decimal(36, 18)
  feeUsd         Decimal?     @db.Decimal(18, 8)
  status         String    // "pending" | "awaiting_deposit" | "in_flight" | "done" | "failed"
  externalId     String?   // provider-side id
  depositAddress String?   // for crypto steps: where funds should be sent
  depositMemo    String?   // required on XRP, TON, XLM, NEAR
  depositBankDetails Json? // for fiat-source (Paycrest onramp) steps: { institution, accountIdentifier, accountName, amountToTransfer, currency }
  paymentChannel String?   // Paystack channel actually used by the payer: "card" | "bank" | "ussd" | "bank_transfer" | "mobile_money" | "qr" | "eft"
  paystackAccessCode String? // Paystack inline popup access code, persisted so a refreshed widget can relaunch the popup
  // Bachs: the charge id ties a collection step to its downstream split transfer.
  // On a Bachs NGN order, seq 0 = collection (charge on our platform balance),
  // seq 1 = transfer (vendor's share). Both carry the same transferGroup = charge id.
  transferGroup  String?
  bachsCheckoutUrl String? // hosted checkout URL for the widget overlay (collection step)
  startedAt      DateTime?
  completedAt    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([orderId, sequence])
  @@index([externalId])
  @@index([provider, externalId])
}

// ── Order events (payment session timeline) ──────────────────────────────────
// Per-transaction event log — the payer's checkout journey (method chosen,
// auth-window open/close, retries, provider transitions). Telemetry, NOT
// compliance: high-volume and prunable, unlike AuditEvent. `source` marks
// whether the event is server-authoritative or client-reported (untrusted).
model OrderEvent {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String   // e.g. "order.created", "deposit.detected", "method.selected"
  label      String   // human line, e.g. "Set payment method to: opay"
  source     String   // "server" (authoritative) | "client" (informational)
  metadata   Json?
  occurredAt DateTime // client-reported time when source=client; else = createdAt
  createdAt  DateTime @default(now()) // server receive time — sort/display by this

  @@index([orderId, createdAt])
}

// ── Audit log ────────────────────────────────────────────────────────────────
// Append-only record of security/compliance-sensitive actions ("who did what").
// Deliberately NOT related to Merchant with a cascade — audit rows must survive
// account deletion. Written best-effort via audit.service; never blocks a request.
model AuditEvent {
  id         String   @id @default(uuid())
  merchantId String?  // whose account this concerns (null for pre-auth/system events)
  actorType  String   // "merchant" | "admin" | "system"
  actorId    String?  // merchant id, admin token subject, or null for system
  action     String   // e.g. "payout.updated", "key.regenerated", "kyb.approved"
  targetType String?  // "instrument" | "merchant" | "webhook" | ...
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   Json?    // action-specific context (never secrets/PANs)
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([action, createdAt])
}

// ── Webhooks ────────────────────────────────────────────────────────────────

model WebhookLog {
  id         String   @id @default(uuid())
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  source     String   // "chainrails" | "paycrest"
  event      String
  externalId String?
  payload    Json
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([source, event, externalId])
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  orderId     String?
  event       String   // e.g. "payment.succeeded"
  
  url         String
  payload     Json
  
  statusCode  Int?
  response    String?
  attempts    Int      @default(1)
  status      String   // "success" | "failed" | "retrying"
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
  @@index([status])
}

// ── Payment Links ────────────────────────────────────────────────────────────

model PaymentLink {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  amount      Decimal  @db.Decimal(18, 8)
  asset       String   // e.g. "NGN", "USDC"
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

// Self-serve cash-out link (the inverse of PaymentLink). A merchant creates one
// and shares it; their user opens the hosted page, supplies THEIR OWN bank
// account, and offramps their crypto to it (crypto→naira via Paycrest). The user
// funds it with their own crypto, so Weave never holds funds.
model PayoutLink {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  // Optional restriction to a single crypto (e.g. "crypto:BASE:USDC"). NULL =
  // chain-agnostic: the user picks ANY supported chain/token they hold and NEAR
  // Intents routes it to naira. Keeping the offramp chain-agnostic is the whole
  // point — Paycrest is only the invisible final fiat leg.
  sourceAsset    String?
  // The fiat the user receives to their bank.
  payoutCurrency String   @default("NGN")
  // Fixed cash-out amount, or null = the user chooses at cash-out time.
  amount         Decimal? @db.Decimal(18, 8)

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([merchantId])
}

enum SubaccountSyncStatus {
  PENDING   // Bank details saved locally, not yet mirrored to Paystack
  SYNCED    // Successfully created/updated on Paystack
  FAILED    // Last sync attempt failed
}

// ── Checkout Sessions ────────────────────────────────────────────────────────
// Single-use, programmatically-created hosted-checkout sessions. The merchant's
// backend calls POST /checkout/sessions and redirects their user to the
// returned checkoutUrl. When the order completes, the user is redirected back
// to redirectUrl. Modeled after Stripe Checkout Sessions / Paystack initialize.

model CheckoutSession {
  id           String    @id @default(cuid())
  merchantId   String
  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  amount       Decimal   @db.Decimal(18, 8)
  amountIn     String    @default("dest")  // "source" | "dest"
  sourceAsset  String?                     // null = payer chooses on the hosted page
  destAsset    String
  reference    String?                     // merchant-supplied — echoed in webhook
  metadata     Json?                       // opaque KV bag — echoed in webhook
  customer     Json?                       // payer identity passthrough — copied to the order on link

  redirectUrl  String
  cancelUrl    String?

  sandboxMode  Boolean   @default(false)
  status       String    @default("open")  // "open" | "processing" | "complete" | "expired"
  orderId      String?                     // set once user initiates payment on hosted page
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([merchantId])
  @@index([status])
  @@index([orderId])
}

// ── Stellar SEP-24 anchor ────────────────────────────────────────────────────
// Weave as a Stellar anchor. Any SEP-24 wallet or platform (Pollar's ramp modal,
// Lobstr, Vibrant…) authenticates the user with SEP-10, then opens our
// interactive page to deposit NGN → USDC on Stellar into the user's OWN account,
// or withdraw USDC → an NGN bank account. Each anchor transaction wraps exactly
// one Weave Order (created from the interactive page, forward-bound through
// Paycrest ↔ Base USDC ↔ NEAR Intents ↔ Stellar) and derives its SEP-24
// `status` from that order's steps. NOT related to getanchor.co (`anchor*`
// fields on Merchant/Order/RouteStep) — that is the Nigerian BaaS rail.
model StellarAnchorTransaction {
  id                    String    @id @default(uuid())
  kind                  String    // "deposit" | "withdrawal"
  account               String    // SEP-10 authenticated Stellar account (G…)
  accountMemo           String?   // SEP-10 memo for shared/omnibus accounts
  assetCode             String    @default("USDC")
  status                String    @default("incomplete") // SEP-24 status vocabulary
  lang                  String?
  // Requested / settled amounts. deposit: in = NGN, out = USDC. withdrawal: in = USDC, out = NGN.
  amountIn              Decimal?  @db.Decimal(36, 18)
  amountOut             Decimal?  @db.Decimal(36, 18)
  amountFee             Decimal?  @db.Decimal(36, 18)

  orderId               String?   @unique
  order                 Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Withdrawal: where the wallet must send the USDC (NEAR Intents Stellar
  // deposit address + per-order memo). SEP-24 `withdraw_anchor_account` /
  // `withdraw_memo` / `withdraw_memo_type`.
  withdrawAnchorAccount String?
  withdrawMemo          String?
  withdrawMemoType      String?   // "text" | "id" | "hash"
  stellarTransactionId  String?   // hash of the Stellar leg once known
  externalTransactionId String?   // Paycrest order id (the fiat leg)
  message               String?
  refunded              Boolean   @default(false)

  // sha256 of the one-time bearer token embedded in the interactive URL; the
  // hosted page presents it to read/link this transaction. Never store plaintext.
  interactiveTokenHash  String    @unique

  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  updatedAt             DateTime  @updatedAt

  @@index([account, startedAt])
  @@index([status])
}
