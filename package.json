{
  "name": "weave-checkout",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @weave/shared build && turbo run dev",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19",
      "@types/react-dom": "^19"
    },
    "packageExtensions": {
      "@coinbase/cdp-sdk": {
        "dependencies": {
          "bs58": "^6.0.0"
        }
      }
    }
  }
}
