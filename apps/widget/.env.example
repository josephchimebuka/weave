# Weave Widget Environment Variables

# API Configuration
VITE_WEAVE_API_KEY=pk_test_123
VITE_API_BASE=http://localhost:4000/api/v1

# Demo/fallback wallet used as refund address when the host app doesn't supply one.
# In production, callers must pass `userAddress` on <WeaveCheckout />.
VITE_WEAVE_DEMO_USER_ADDRESS=0x2B4fB6F7255DeF56d985fb01134ab1431Efbd3be

# Vendor Output Type: "stablecoin" or "fiat"
VITE_WEAVE_OUTPUT_TYPE=stablecoin

# Fiat Currencies (comma-separated)
VITE_WEAVE_FIAT_CURRENCIES=NGN

# Stablecoin Configuration (if outputType is "stablecoin")
VITE_WEAVE_STABLECOIN_SYMBOL=USDC
VITE_WEAVE_STABLECOIN_CHAIN=BASE

# Theme
VITE_WEAVE_PRIMARY_COLOR=#0F5D4C

# Stellar (Priority 1 — must match API STELLAR_NETWORK)
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Optional override; defaults to Circle USDC issuer per network
VITE_STELLAR_USDC_ISSUER=
# Checkout UX: infra = payment-first copy; dev = explicit Stellar branding (demos)
VITE_PAYMENT_COPY_MODE=infra
# Set false to hide stablecoin wallet pay-in (also respects API STELLAR_CHECKOUT_ENABLED)
# VITE_STELLAR_CHECKOUT_ENABLED=true
