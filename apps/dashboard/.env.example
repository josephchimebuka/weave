# The base URL of the Weave API (server-side fetches only)
API_BASE=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1

# Cloudinary — server-side only for signed KYB document uploads
# Never use NEXT_PUBLIC_ for these; they are generated via /api/cloudinary-sign
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: used by the dev embed page to pre-fill the publishable key
# WEAVE_API_KEY=pk_live_...

# Stellar on cash-out wallet pay (fallback if /stellar/config fails; production should be mainnet)
# NEXT_PUBLIC_STELLAR_NETWORK=mainnet
