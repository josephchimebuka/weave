# API Configuration
# Local dev: use localhost so Stellar poll jobs work if you enable QStash later
API_BASE=http://localhost:4000/api/v1
PORT=4000
NODE_ENV=development
# Number of trusted proxy hops in front of the app (Express `trust proxy`), so
# req.ip is the real visitor and not a proxy address. Default 2 = Cloudflare +
# platform proxy. Must EXACTLY match your chain: too low shows a proxy IP, too
# high makes X-Forwarded-For spoofable. Raw VM directly behind Cloudflare = 1.
TRUST_PROXY_HOPS=2

# Database — REQUIRED. Example for docker-compose postgres in repo root:
# DATABASE_URL=postgresql://weave:weave@localhost:5432/weave
DATABASE_URL=postgresql://weave:weave@localhost:5432/weave

# Redis (BullMQ - Local Only)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Redis (Serverless Rate Limiting - HTTP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash (Serverless Jobs)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=https://qstash.upstash.io/v2

# Paystack (NGN domestic bank transfer — DVA settlement)
# Kill switch: Paystack naira collection is DISABLED unless this is exactly "true".
# The router refuses to plan a Paystack hop and the executor refuses to dispatch
# one, so no widget or API caller can start a naira charge. Flip to "true" only
# when a working naira corridor is restored.
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
# Sandbox test key. Setting the SECRET test key makes sandbox (pk_test_/sk_test_
# merchant keys) provision a REAL Paystack test transaction, exercising checkout
# end-to-end with test cards. Leave blank to keep sandbox fully mocked (instant
# auto-complete). The publishable key is optional — the widget resumes the popup
# via the server-minted access code and never reads it.
PAYSTACK_SECRET_KEY_TEST=sk_test_...
PAYSTACK_PUBLIC_KEY_TEST=pk_test_...   # optional

# Bachs Connect (licensed NGN collection — Paystack replacement, split payments)
# Kill switch: NGN→NGN routes through Bachs only when this is exactly "true".
# Dewdrop is a Connect PLATFORM; each vendor is a connected account. We collect on
# our platform balance (funds custodied by Bachs, the licensed party) then split
# each vendor its share.
BACHS_ENABLED=false
# LIVE credentials (real merchants / real money).
BACHS_API_BASE=https://api.bachs.io
BACHS_SECRET_KEY=sk_live_...
BACHS_WEBHOOK_SECRET=                          # signing secret from the LIVE webhook endpoint
# SANDBOX credentials. Setting the sandbox SECRET key makes Weave sandbox NGN→NGN
# orders provision a REAL Bachs sandbox checkout (real overlay + test card), settled
# on poll in syncOrder — exactly like Paystack test mode. Leave blank to keep sandbox
# fully mocked (instant-complete). Sandbox settlement is poll-based, so no sandbox
# webhook secret is needed.
BACHS_SANDBOX_API_BASE=https://sandbox-api.bachs.io
BACHS_SECRET_KEY_TEST=sk_sandbox_...
# Payout (withdrawal) timing. After a collection's split settles into the vendor's
# connected-account balance, Weave withdraws it to the vendor's bank. BACHS_PAYOUT_HOLD_S
# is the delay before that withdrawal fires — the lever for holding funds (float, fraud
# review, batching). 0 = pay out immediately once the split settles.
BACHS_PAYOUT_HOLD_S=0
# BACHS_PAYOUT_RETRY_S=1800        # re-check cadence when the balance isn't yet available (default 30m)
# BACHS_PAYOUT_MAX_ATTEMPTS=40     # give up after this many retries

# ChainRails (connected-wallet flow — not fully wired yet)
CHAINRAILS_API_URL=https://api.chainrails.io/api/v1
CHAINRAILS_API_KEY=
CHAINRAILS_WEBHOOK_SECRET=

# NEAR Intents 1Click (send-from-another-wallet flow — primary provider today)
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com/v0
NEAR_INTENTS_JWT=your_jwt_here

# Poll interval in ms for the NEAR Intents status worker (default 15000)
NEAR_POLL_INTERVAL_MS=15000

# Paycrest Sender API
PAYCREST_API_URL=https://api.paycrest.io/v2
PAYCREST_API_KEY=
PAYCREST_WEBHOOK_SECRET=

# Timeout (ms) for delivering an outgoing webhook to a merchant endpoint before
# aborting and letting QStash retry. Keep generous for cold-starting serverless
# receivers. Default 20000 = 20s.
WEBHOOK_DISPATCH_TIMEOUT_MS=20000

# System-owned EVM address used as Paycrest's refundAddress. Paycrest validates
# refund addresses against its refund leg (Base USDC), so when the user pays
# from a non-EVM chain (Solana, TRON, etc.) we can't forward their origin-chain
# refund address to Paycrest. Must be a valid 0x… address.
WEAVE_EVM_REFUND_ADDRESS=

# Merchant payout config (demo-only — moves to dashboard later)
MERCHANT_PAYOUT_INSTITUTION=GTBINGLA
MERCHANT_PAYOUT_ACCOUNT_IDENTIFIER=1234567890
MERCHANT_PAYOUT_ACCOUNT_NAME=Your Merchant Name
MERCHANT_PAYOUT_WALLET_ADDRESS=0xYourMerchantWalletAddress
MERCHANT_PAYOUT_WALLET_CHAIN=base

# Fee config (can be overridden per client in future)
SENDER_FEE_BPS=75     # 0.75%
APP_FEE_BPS=10        # 0.10%

# Swap-slippage buffer. Applied to dest-anchored quotes so the merchant always
# receives at least the requested fiat amount even after NEAR Intents eats its
# cross-chain spread. Also doubles as the slippageTolerance we pass to NEAR
# Intents so the swap doesn't abort mid-flight. 200 = 2%.
SLIPPAGE_BUFFER_BPS=200

# Minimum USD value for a crypto-funded payment. Sub-dollar crypto legs get
# swallowed by provider dust floors and swap/bridge fees, so quotes/orders below
# this are rejected up-front. Default 0.5 = $0.50.
MIN_CRYPTO_PAYMENT_USD=0.5

NODE_ENV=development
PORT=4000

# Dashboard auth session + password reset
AUTH_SESSION_TTL_HOURS=24
AUTH_RESET_TTL_MINUTES=15

# Email service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@weave.dev
ADMIN_EMAIL=
# Merchant account(s) that can view the platform-wide audit log (the Dewdrop
# Labs internal account). Comma-separated emails; matched against the logged-in
# merchant's own email. Everyone else only ever sees their own audit events.
PLATFORM_ADMIN_EMAILS=
DASHBOARD_URL=http://localhost:3001

# Dev-only: set to "true" to skip QStash signature verification locally.
# Never set this in production.
SKIP_QSTASH_VERIFICATION=true

# ── Stellar (Priority 1 — USDC treasury collection) ─────────────────────────
# testnet | mainnet
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Hide Stellar wallet checkout in widget when false (Horizon/treasury can stay configured)
# STELLAR_CHECKOUT_ENABLED=true
# Weave treasury account — public key safe in env; secret in vault only
WEAVE_STELLAR_PUBLIC_KEY=
WEAVE_STELLAR_SECRET_KEY=
# Circle USDC issuer (defaults per network if unset)
# testnet: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# mainnet: GA5ZSEJYB37JRC5EAAOKU5YDTYNNAMDR2EMH5QAFB5S64XAHQXHUM5N
STELLAR_USDC_ISSUER=
# Horizon poll interval for payment detection (default 10000ms)
STELLAR_POLL_INTERVAL_MS=10000

# Sentry error tracking. Leave SENTRY_DSN blank to disable entirely (local dev
# and tests run clean with no reporting). SENTRY_TRACES_SAMPLE_RATE is the
# fraction of requests traced for performance (0.1 = 10%); errors are always
# captured regardless. SENTRY_RELEASE optionally tags events with a deploy.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# Structured logging → Axiom. Set BOTH to ship logs to Axiom (plus stdout);
# leave blank for stdout-only (pretty in dev, JSON in prod). LOG_LEVEL defaults
# to "debug" in dev and "info" in prod.
# AXIOM_URL: EU-region datasets use the edge endpoint
# https://eu-central-1.aws.edge.axiom.co (default); US uses
# https://us-east-1.aws.edge.axiom.co.
# By default logs go as JSON to stdout — ship them to Axiom with a platform Log
# Drain (Vercel → Axiom). Set AXIOM_INPROCESS=true ONLY on a long-running host
# (never serverless) to ship directly via pino's in-process worker transport.
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_URL=
AXIOM_INPROCESS=
LOG_LEVEL=


# ── Stellar anchor (SEP-1 / SEP-10 / SEP-24) + Pollar corridor ──────────────
# NOT getanchor.co (see ANCHOR_* above). Weave exposes the NGN corridor to any
# SEP-24 wallet/platform (Pollar's ramp modal). stellar.toml is served from the
# API domain root; the home domain defaults to the API_BASE host.
STELLAR_NETWORK=mainnet                 # mainnet | testnet
# STELLAR_HORIZON_URL=https://horizon.stellar.org
# STELLAR_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
# STELLAR_ANCHOR_HOME_DOMAIN=api.paywithweave.com
# Signing key for SEP-10 challenges (SIGNING_KEY in stellar.toml). Falls back to
# WEAVE_STELLAR_SECRET_KEY. Only ever signs auth challenges — never moves funds.
STELLAR_ANCHOR_SIGNING_SECRET=
WEAVE_STELLAR_PUBLIC_KEY=G...
WEAVE_STELLAR_SECRET_KEY=S...
# HMAC secret for the SEP-10 JWTs we mint. Falls back to ADMIN_SECRET.
STELLAR_ANCHOR_JWT_SECRET=
# System merchant that owns anchor-originated orders (auto-created).
STELLAR_ANCHOR_MERCHANT_EMAIL=stellar-anchor@paywithweave.com
# true → interactive pages use the anchor merchant's pk_test_ key (mocked rails).
STELLAR_ANCHOR_SANDBOX=false
# Corridor limits advertised in SEP-24 /info.
SEP24_NGN_MIN=1000
SEP24_NGN_MAX=5000000
SEP24_USDC_MIN=1
SEP24_USDC_MAX=5000

# Sandbox Stellar simulator — TESTNET ONLY. Stands in for the bridge counterparty
# (NEAR Intents / Circle CCTP) on sandbox orders: pays faucet USDC into the user's
# wallet on deposits, receives their memo payment on cash-outs. Unreachable from
# live orders. Fund via faucet.circle.com (Stellar testnet).
WEAVE_SANDBOX_STELLAR_SECRET=S...
SANDBOX_FAUCET_MAX_USDC=50

# LI.FI — Stellar USDC → Base USDC via Circle CCTP (non-custodial; the payer
# signs approve + bridge on Stellar, USDC mints straight into Paycrest on Base).
LIFI_API_KEY=
# LIFI_API_URL=https://li.quest/v1
# LIFI_INTEGRATOR=weave

# Pollar (corridor app / server API)
POLLAR_PUBLISHABLE_KEY_TEST=pub_testnet_...
POLLAR_SECRET_KEY_TEST=sec_testnet_...
