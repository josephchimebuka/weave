# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/weave"

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ChainRails (connected-wallet flow — not fully wired yet)
CHAINRAILS_API_URL=https://api.chainrails.io/api/v1
CHAINRAILS_API_KEY=
CHAINRAILS_WEBHOOK_SECRET=

