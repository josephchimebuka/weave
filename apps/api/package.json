{
  "name": "@weave/api",
  "version": "1.0.0",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "ts-node-dev --respawn src/index.ts",
    "db:push": "prisma db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "stellar:setup-trustline": "ts-node-dev --transpile-only scripts/setup-stellar-treasury.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "@upstash/qstash": "^2.10.1",
    "@upstash/redis": "^1.37.0",
    "@weave/shared": "workspace:*",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitest/coverage-v8": "^2.1.9",
    "prisma": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
